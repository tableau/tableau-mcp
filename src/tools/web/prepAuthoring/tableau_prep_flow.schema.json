                  }
                }
              },
              "computeUsingColumnName": { "type": "string" },
              "aggregatedColumn": { "type": "string" }
            }
          }
        }
      },
      "filterOperation": {
        "type": "object",
        "properties": {
          "nodeType": { "const": ".v1.FilterOperation" },
          "baseType": { "const": "transform" },
          "filterExpression": { "type": "string" }
        }
      },
      "removeColumns": {
        "type": "object",
