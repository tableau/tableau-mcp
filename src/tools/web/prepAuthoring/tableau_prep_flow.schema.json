      },
      "multiRowCalc": {
        "type": "object",
        "properties": {
          "nodeType": { "pattern": "^\\.v[0-9]+(_[0-9]+)*\\.MultiRowCalc$" },
          "baseType": { "const": "transform" },
          "columnName": { "type": "string" },
          "expression": { "type": "string" },
          "fieldId": { "type": "string" },
