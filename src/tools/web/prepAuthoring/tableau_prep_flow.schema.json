{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.tableau-prep-schema/tableau_prep_flow.schema.json",
  "title": "Tableau Prep package metadata",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "flow": { "$ref": "#/$defs/flow" },
    "displaySettings": { "$ref": "#/$defs/displaySettings" },
    "maestroMetadata": { "$ref": "#/$defs/maestroMetadata" },
    "archiveEntries": { "$ref": "#/$defs/archiveEntries" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "versionedType": {
      "type": "string",
      "pattern": "^\\.v[0-9]+(_[0-9]+)*\\.[A-Za-z0-9_]+$"
    },
    "authoringProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "namespace", "flow"],
      "x-value-evidence": {"kind": "authoring-policy", "note": "YAML project envelope after tag expansion; metadata is validated after ID/default expansion. This envelope is not a native Tableau file format"},
      "properties": {
        "format": {"const": "tableau-prep-flow/v1"},
        "namespace": {"$ref": "#/$defs/uuid"},
        "ids": {"type": "object", "additionalProperties": {"$ref": "#/$defs/uuid"}},
        "defaults": {"type": "boolean", "default": true},
        "flow": {"type": "object", "additionalProperties": true},
        "displaySettings": {"$ref": "#/$defs/displaySettings"},
        "maestroMetadata": {"$ref": "#/$defs/maestroMetadata"},
        "files": {"type": "array", "default": [], "items": {
          "type": "object", "additionalProperties": false, "required": ["entry", "source"],
          "properties": {
            "entry": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
            "source": {"type": "string"}
          }
        }}
      }
    },
    "nativeXmlDataType": {
      "type": "string",
      "enum": ["integer", "boolean", "real", "string", "date", "datetime", "tuple", "spatial", "table"],
      "x-value-evidence": {"kind": "ghidra-decompilation", "source": "docs/analysis/ghidra_tabfileformat_value_formats.json", "function": "ColumnParserUtils::ParseDataTypeAttribute", "address": "180066134", "context": "native XML datatype attribute", "unknownHandling": "Unrecognized text returns the native unknown code; this is not an exhaustive flow JSON enum"}
    },
    "nativeXmlSortMode": {
      "type": "string",
      "enum": ["alphabetic-sort", "computed-sort", "manual-sort", "natural-sort"],
      "x-value-evidence": {"kind": "ghidra-decompilation", "source": "docs/analysis/ghidra_tabfileformat_value_formats.json", "function": "SortParser::GetSortType", "address": "1800fe7f8", "context": "native XML element name; NOT flow JSON sortType ASC/DESC"}
    },
    "jsonDataTypeText": {
      "type": ["string", "null"],
      "examples": ["integer", "boolean", "real", "string", "date", "datetime", "spatial"],
      "x-native-known-values": "#/$defs/nativeXmlDataType",
      "x-value-evidence": {"kind": "package-observation", "nativeSpellingSource": "ColumnParserUtils::ParseDataTypeAttribute", "note": "Unknown private JSON spellings remain open; native XML recognition is not proof of the complete JSON domain"}
    },
    "flow": {
      "$comment": "Ghidra evidence: tabfileformat.dll ObjectGraphParser/ObjectGraphNodeParser/ObjectGraphNodeFormatter and loomsupport.dll flow-name/flow-output-* strings in docs/analysis/ghidra_*_schema_evidence.json.",
      "type": "object",
      "additionalProperties": true,
      "required": ["nodes"],
      "properties": {
        "parameters": { "type": "object", "additionalProperties": true, "default": {}, "x-value-evidence": {"kind": "authoring-policy", "formatSource": "ObjectGraphParser.cpp"} },
        "initialNodes": {
          "type": "array",
          "x-authoring-generated": "graph-roots",
          "items": { "$ref": "#/$defs/uuid" }
        },
        "nodes": {
          "$comment": "Ghidra evidence: ObjectGraphNodeParser.cpp, ObjectGraphNodeFormatter.cpp, ObjectGraphParser.cpp.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "connections": {
          "$comment": "Ghidra evidence: DataConnectionParser.cpp, DataConnectionFormatter.cpp, ConnectionPropertyFormatter.cpp, plus loomsupport GetConnectionAttributes/GetConnectionInfo symbols.",
          "type": "object",
          "default": {},
          "additionalProperties": { "$ref": "#/$defs/connection" }
        },
        "dataConnections": {
          "$comment": "Ghidra evidence: DataConnectionParser.cpp/DataConnectionFormatter.cpp and loomsupport.dll ConnectionPayload/GetConnectionAttributes symbols.",
          "type": "object",
          "default": {},
          "additionalProperties": { "$ref": "#/$defs/dataConnection" }
        },
        "connectionIds": {
          "type": "array",
          "x-authoring-generated": "connection-keys",
          "items": { "$ref": "#/$defs/uuid" }
        },
        "dataConnectionIds": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "nodeProperties": {
          "$comment": "Ghidra evidence: tabfileformat.dll object model parser/formatter symbols show graph node payloads are extensible.",
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/nodeProperty" }
          }
        },
        "extensibility": { "type": ["object", "null"], "additionalProperties": true, "default": {} },
        "selection": { "type": ["object", "array", "string", "null"], "additionalProperties": true, "default": null },
        "majorVersion": { "type": "integer", "default": 1, "x-value-evidence": {"kind": "authoring-policy", "observedPackageValue": 1} },
        "minorVersion": { "type": "integer", "default": 0, "x-value-evidence": {"kind": "authoring-policy", "note": "A writer baseline, not a Ghidra-proven native default"} },
        "documentId": { "type": "string", "x-authoring-generated": "uuid5:document" },
        "obfuscatorId": { "type": "string", "x-authoring-generated": "uuid5:obfuscator" }
      }
    },
    "edge": {
      "$comment": "Ghidra evidence: ObjectGraphParser.cpp and ObjectModelRelationshipParser.cpp.",
      "type": "object",
      "additionalProperties": true,
      "required": ["nextNodeId"],
      "properties": {
        "namespace": { "type": "string", "default": "Default", "x-value-evidence": {"kind": "package-observation", "source": "apps/prep-flow-workbench/src/dev-samples"} },
        "nextNodeId": { "$ref": "#/$defs/uuid" },
        "nextNamespace": { "type": "string", "default": "Default" }
      }
    },
    "node": {
      "allOf": [
        { "$ref": "#/$defs/commonNode" },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.Container"}}}, "then": {"$ref": "#/$defs/nodeVariants/container"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"pattern": "^\\.v[0-9]+(_[0-9]+)*\\.LoadExcel$"}}}, "then": {"$ref": "#/$defs/nodeVariants/loadExcel"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.AddColumn"}}}, "then": {"$ref": "#/$defs/nodeVariants/addColumn"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"pattern": "^\\.v[0-9]+(_[0-9]+)*\\.MultiRowCalc$"}}}, "then": {"$ref": "#/$defs/nodeVariants/multiRowCalc"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.FilterOperation"}}}, "then": {"$ref": "#/$defs/nodeVariants/filterOperation"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.RemoveColumns"}}}, "then": {"$ref": "#/$defs/nodeVariants/removeColumns"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.PublishExtract"}}}, "then": {"$ref": "#/$defs/nodeVariants/publishExtract"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.LoadCsv"}}}, "then": {"$ref": "#/$defs/nodeVariants/loadCsv"} },
        { "if": {"required": ["nodeType"], "properties": {"nodeType": {"const": ".v1.WriteToHyper"}}}, "then": {"$ref": "#/$defs/nodeVariants/writeToHyper"} }
      ]
    },
    "commonNode": {
      "$comment": "Ghidra evidence: ObjectGraphNodeParser.cpp/ObjectGraphNodeFormatter.cpp establish node-level parse/format handling; schema keeps unknown node payload fields for private Tableau extensions.",
      "type": "object",
      "additionalProperties": true,
      "required": ["nodeType", "id", "baseType"],
      "x-value-evidence": {"kind": "package-observation", "nativeStructureSource": "ObjectGraphNodeParser.cpp/ObjectGraphNodeFormatter.cpp", "note": "Defaults are writer policy, not reverse-engineered native defaults"},
      "properties": {
        "nodeType": { "$ref": "#/$defs/versionedType" },
        "name": { "type": ["string", "null"] },
        "id": { "$ref": "#/$defs/uuid", "x-authoring-generated": "node-key" },
        "baseType": {
          "$comment": "Observed packages also use superNode; future/private base categories remain extensible, as do nodeType variants.",
          "type": "string"
        },
        "nextNodes": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/edge" }
        },
        "serialize": { "type": "boolean", "default": false },
        "description": { "type": ["string", "null"], "default": null }
        ,
        "fields": {
          "$comment": "Ghidra evidence: field/fields strings, ColumnParser.cpp, ConnectionFieldsParser::ReadFieldFromDOM, loomsupport gen-field-pres-model.",
          "anyOf": [
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/fieldMetadata" } },
            { "type": "array", "items": { "$ref": "#/$defs/fieldMetadata" } }
          ]
        },
        "columns": {
          "$comment": "Ghidra evidence: column/columns strings, ColumnDefnParser.cpp, ColumnInstanceParser.cpp, ColumnParser.cpp.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/columnMetadata" }
        },
        "filters": {
          "$comment": "Ghidra evidence: FilterParser.cpp, FilterFormatter.cpp, filter-fields strings.",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/filterMetadata" }
        },
        "relation": {
          "$comment": "Ghidra evidence: DataSourceRelationships.cpp and ObjectModelRelationshipParser.cpp.",
          "anyOf": [
            { "$ref": "#/$defs/relationMetadata" },
            { "type": "null" }
          ]
        },
        "connectionId": {
          "$comment": "Observed Data Cloud output uses an opaque external connection identity rather than a local connection UUID.",
          "type": "string"
        },
        "connectionAttributes": { "$ref": "#/$defs/connectionAttributes" }
      }
    },
    "nodeVariants": {
      "container": {
        "type": "object",
        "properties": {
          "nodeType": { "const": ".v1.Container" },
          "baseType": { "const": "container" },
          "loomContainer": { "$ref": "#/$defs/flow" },
          "namespacesToInput": { "type": "object", "additionalProperties": true },
          "namespacesToOutput": { "type": "object", "additionalProperties": true },
          "providedParameters": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "loadExcel": {
        "type": "object",
        "x-value-evidence": {"kind": "package-observation", "source": "apps/prep-flow-workbench/src/dev-samples", "note": "Integer timestamps, nullable field collections and object group-by entries were observed; no exhaustive native JSON value domain was established"},
        "properties": {
          "nodeType": { "pattern": "^\\.v[0-9]+(_[0-9]+)*\\.LoadExcel$" },
          "baseType": { "const": "input" },
          "connectionId": { "$ref": "#/$defs/uuid" },
          "connectionAttributes": { "$ref": "#/$defs/connectionAttributes" },
          "fields": { "$ref": "#/$defs/commonNode/properties/fields" },
