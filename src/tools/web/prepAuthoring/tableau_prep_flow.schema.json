          "updateTimestamp": { "type": ["integer", "null"] },
          "restrictedFields": { "type": ["object", "null"], "additionalProperties": true },
          "userRenamedFields": { "type": "object", "additionalProperties": true },
          "selectedFields": { "type": ["array", "null"], "items": { "type": "string" } },
          "samplingType": { "type": ["string", "null"] },
          "groupByFields": { "type": ["array", "null"], "items": { "$ref": "#/$defs/fieldMetadata" } },
          "filters": { "$ref": "#/$defs/commonNode/properties/filters" },
          "relation": {
            "anyOf": [
              { "$ref": "#/$defs/relationMetadata" },
              { "type": "null" }
            ]
          }
        }
      },
      "addColumn": {
        "type": "object",
        "properties": {
          "nodeType": { "const": ".v1.AddColumn" },
          "baseType": { "const": "transform" },
          "columnName": { "type": "string" },
          "expression": { "type": "string" }
